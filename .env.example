# Copy this file to .env and adjust values for local development.
# Never commit a real .env file with production secrets.

# Backend
JWT_SECRET_KEY=dev-secret-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# Seeded dev users (created by `docker compose exec backend python scripts/dummy_candidates.py`)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin@123
SEED_REVIEWER_EMAIL=reviewer@example.com
SEED_REVIEWER_PASSWORD=reviewer@123

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
